AGENT_MODEL=qwen2.5-coder:14b
ANALYSIS_MODEL=llama3.2:1b
RESUME=false
# Max time in minutes for the agent per repo (checkpoints every 20 min)
MAX_TIMEOUT_MINUTES=60
GITHUB_REPO=
# Comma-separated list of GitHub repos to reproduce
GITHUB_REPOS=

# --- Context / truncation limits (adjust for your model's context window) ---
# README chars sent to the OpenHands agent
AGENT_README_MAX_CHARS=30000
# Max chars for event summary (tail-biased)
EVENT_SUMMARY_MAX_CHARS=8000
# Max chars per individual event output in summary
EVENT_OUTPUT_MAX_CHARS=1000
# README chars sent to the Ollama analyzer
ANALYZER_README_MAX_CHARS=15000
# Agent output chars sent to the Ollama analyzer
ANALYZER_OUTPUT_MAX_CHARS=20000
# OpenHands per-observation message limit (requires image rebuild)
OPENHANDS_MAX_MESSAGE_CHARS=30000
# OpenHands condenser attention window (requires image rebuild)
OPENHANDS_ATTENTION_WINDOW=25
